# =====================================================================
# sales-call-analysis-agent - example environment file
#
# Copy to `.env` and adjust as needed. Every variable below has a safe
# local-development default built into the code and docker-compose.yml,
# so a `.env` file is OPTIONAL for the first run.
#
# Never commit a real `.env` file (it is git-ignored).
# =====================================================================

# --- Application settings (read by src/sales_call_agent/config.py) ---

# Deployment environment name: development | staging | production
APP_ENVIRONMENT=development

# Enable verbose debug behavior (true/false)
APP_DEBUG=false

# PostgreSQL connection URL (SQLAlchemy format, psycopg driver).
# The value below matches the docker-compose defaults.
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sales_calls

# --- docker-compose PostgreSQL settings (defaults shown) ---

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sales_calls
POSTGRES_PORT=5432
